			tasks: [ { id: "1D31DBC84E2DA6E1" advancement: "cataclysm:kill_ignis" criterion: "" type: "advancement" } ]
			title: "Владыка Огня"
			x: 2d
			y: 0d
		},
		{
			dependencies: [ "1AC2512266D20CDF" ]
			description: [
				"Его собрали из металла, который помнит прикосновение. Оно глухо ко всему, кроме собственного веса."
				"Пустоши куют такое оружие, но не умеют его останавливать."
			]
			id: "19E4B0FB17DBA37D"
			rewards: [
