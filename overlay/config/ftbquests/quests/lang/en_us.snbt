{
	chapter.11F71A3D81DCE03F.title: "Глаза"
	chapter.1432575486FC90E7.title: "Магия"
	chapter.169B5232420F318F.title: "Слух"
	chapter.16AD09692F2D7AAB.title: "Кухня"
	chapter.18E431C0CFB1FAB0.title: "Врата и Владыки"
	chapter.19EA245EB0DEB868.title: "Крысы"
	chapter.1A297FC23F72376A.title: "Предания"
	chapter.1C2E6C0EFDF6F947.title: "Фамильяры"
	chapter.1CDAE8B527AD4704.title: "Первое дыхание"
	chapter.1F3103B372D75754.title: "Драконы"
	quest.1035023E7C91BC75.quest_desc: [
		"Врата не крафтятся в верстаке: их собирают из ядра и камня, а ключ задаёт волну."
		"Не ставь Врата у дома — волны не различают, кто твой."
	]
	quest.1035023E7C91BC75.title: "Сборка врат"
	quest.1055BD7EE08AE55D.quest_desc: [
		"Очков хватит не на всё. Дерево не прощается с тобой щедро: лучше глубоко в двух ветвях, чем по чуть-чуть в семи."
		"Перед боссом смотри, что уже взято, а не что хочется."
	]
	quest.1055BD7EE08AE55D.title: "Очки не бесконечны"
	quest.1072DFC4805CFBD3.quest_desc: [
		"Драконья сталь — три вида: огненная, ледяная, грозовая. Плавится из крови и железа."
		"На Острове Истоков она нужна в ритуалах восстановления глаз: подойдёт любая."
	]
	quest.1072DFC4805CFBD3.title: "Драконья сталь"
	quest.109C62E3327695F9.quest_desc: [
		"Идол фамильяра — редкость с Острова Истоков: семь урона, бонус урона фамильяра и кулдаунов."
		"Не продавай его первому встречному торговцу."
	]
	quest.109C62E3327695F9.title: "Идол"
	quest.110471AB85FCC2BE.quest_desc: [
		"Она вросла в собственный корабль: не плывёт, а звучит изнутри. Моряки говорят, что слышат её раньше, чем видят."
		"Тварь, которая стала судном, — плохой знак для тех, кто слышит."
	]
	quest.110471AB85FCC2BE.quest_subtitle: "Предание VII"
	quest.110471AB85FCC2BE.title: "Сцилла"
	quest.1114B29636249C7B.quest_desc: [
		"Двенадцать глаз End Remastered открывают портал Края. Каждый падает с конкретного босса и только один раз на игрока — и только если последний удар твой."
		"Потеряешь око — не приговор: на Острове Истоков есть страховочный ритуал. Об этом — в разделе «Глаза»."
	]
	quest.1114B29636249C7B.title: "Глаза падают один раз"
	quest.111EC7C42A78C0C2.quest_desc: [
		"Последний страж помнит, зачем строй вообще держали. Он держит последнюю ноту — и потому не может уйти."
		"Край — место, где нестрой стоит неподвижно. Страж следит, чтобы он не пошёл дальше."
	]
	quest.111EC7C42A78C0C2.quest_subtitle: "Предание VI"
	quest.111EC7C42A78C0C2.title: "Страж Края"
	quest.11368A7F845ACEED.quest_desc: [
		"Погибнув, ты не теряешь всё: тело остаётся лежать там, где ты упал, и вещи лежат в нём."
		"Но время играет против тебя, а место запоминается плохо. Ставь метку и не беги в недра без плана."
	]
	quest.11368A7F845ACEED.title: "Смерть — сбитая нота"
	quest.113FA7B057C15DC6.quest_desc: [
		"Сосуды падают не из сундуков: Иссушитель, дракон Края и победа над рейдом. Каждый сосуд — плюс пятьдесят дыхания, и больше десяти их не выпить."
		"Один лишний сосуд — это лишний круг над пропастью."
	]
	quest.113FA7B057C15DC6.title: "Сосуды дыхания"
	quest.115EE1D457548217.quest_desc: [
		"Трофей с Кобольдиатора. Пока око у тебя, ачивка помнит: второй раз оно не выпадет."
		"Потеряешь — восстановишь ритуалом на Острове Истоков, ценой трофея и материалов."
	]
	quest.115EE1D457548217.quest_subtitle: "1 легендарное чернило"
	quest.115EE1D457548217.title: "Око Изгоя"
	quest.116AF83692B907C5.quest_desc: [
		"Отдельные курио не привязаны к фамильяру: Heart of Ender (уклонение), Holy Water Grail (лечение), Invisibility Robes (невидимость), Mirror of Truth, Magic Eye."
		"Statue of Willpower и Pandora's Box — тоже отсюда, но они про другое."
	]
	quest.116AF83692B907C5.title: "Курио"
	quest.11AB77CF39486D84.quest_desc: [
		"В дереве семь дорог: клинок, лук, магия, школы заклинаний, шахта, фамильяры и общее."
		"Ветку шахтёра мы добавили сами — она про кирку, руду, свет под землёй и скорость ног в туннеле."
	]
	quest.11AB77CF39486D84.title: "Семь ветвей"
	quest.11B6DDEE7B93E4AC.quest_desc: [
		"Взрослый прирученный дракон летает и жжёт. Это не транспорт, а второй голос в бою."
		"Но и на тебя смотрят сверху: дракон в небе виден всем."
	]
	quest.11B6DDEE7B93E4AC.title: "Верхом"
	quest.123982B2B230DB60.quest_desc: [
		"Shiny Crown (архимаг), Emblem of Electricity (маг молний), Conjurer's Candlestick (поджигатель), Frostbloom (морозник)."
		"Все четыре качают силу школы и не требуют, чтобы фамильяр был один: главное — чтобы он был призван."
	]
	quest.123982B2B230DB60.title: "Тринкеты магов"
	quest.12948680916F0277.quest_desc: [
		"Между голосами — полутон: чужая ошибка и твой шанс. Часть заклинаний кастуется не туда, и это нормально."
		"Держи под рукой два-три разных заклинания: один голос против босса почти всегда проигрывает."
	]
	quest.12948680916F0277.title: "Полутон"
	quest.12E76C9B72EC03E5.quest_desc: [
		"Он отдал корону за бессмертие и получил голод. Теперь его двор — те, кто не смог уйти."
		"Проклятые не злые. Они просто очень давно не слышали тишины."
	]
	quest.12E76C9B72EC03E5.quest_subtitle: "Предание IV"
	quest.12E76C9B72EC03E5.title: "Король Проклятых"
	quest.12ED2772C1215695.quest_desc: [
		"Кроме дерева есть атрибуты: здоровье, броня, сила чар, скорость. Они качаются отдельно и складываются с деревом."
		"Смотри ATTRIBUTES в инвентаре — там видно, что реально выросло, а что красиво звучит."
	]
	quest.12ED2772C1215695.title: "Атрибуты"
	quest.135562509AA98E9D.quest_desc: [
		"На острове живут неприкаянные души — ранние формы фамильяров. Их ловят пустой бутылкой."
		"Пойманная душа — ядро почти любого ритуала. Не трать на мелочи."
	]
	quest.135562509AA98E9D.title: "Души в бутылках"
	quest.13778E0EA1517106.quest_desc: [
		"Трофей с Иссушителя. Пока око у тебя, ачивка помнит: второй раз оно не выпадет."
		"Потеряешь — восстановишь ритуалом на Острове Истоков, ценой трофея и материалов."
	]
	quest.13778E0EA1517106.quest_subtitle: "1 легендарное чернило"
	quest.13778E0EA1517106.title: "Око Иссушителя"
	quest.13800AACAD40911E.quest_desc: [
		"Трофей с Древнего Стража. Пока око у тебя, ачивка помнит: второй раз оно не выпадет."
		"Потеряешь — восстановишь ритуалом на Острове Истоков, ценой трофея и материалов."
	]
	quest.13800AACAD40911E.quest_subtitle: "1 легендарное чернило"
	quest.13800AACAD40911E.title: "Око Стража"
	quest.138B1E4E27451DC8.quest_desc: [
		"Cinematic Delight, Lender's Delight и Ice and Fire Community Delight — это не просто новые блюда, а новые ингредиенты."
		"Драконье мясо, мёд, выпечка: чем шире рацион, тем ровнее сытость."
	]
	quest.138B1E4E27451DC8.title: "Аддоны"
	quest.13D1AE0EFE139741.quest_desc: ["Кухня — для жизни, а не для фарма. Награды здесь скромные специально: еда должна быть привычкой, а не источником лута."]
	quest.13D1AE0EFE139741.title: "Не гонись за наградой"
	quest.13E90EF86D90CE9E.quest_desc: [
		"Книги заклинаний Iron's в верстаке больше не собрать. Их варит жаровня Эйдолона: реагент на жаровне, остальное — на пьедесталах вокруг."
		"Каждая книга — свой набор пьедесталов. Смотри JEI, а не гадай."
	]
	quest.13E90EF86D90CE9E.title: "Книги на жаровне"
	quest.14436C9E32F126F9.quest_desc: [
		"Выносливость — не мана и не здоровье. Она тратится, пока ты планируешь на параплане, и возвращается, когда стоишь на земле."
		"Старт — 300 единиц. Сосуды дыхания выбиваются из Иссушителя, дракона Края и рейдов; каждый даёт +50 и их не больше десяти."
		"В недра не спускайся с пустым дыханием — обратно уже не вылетишь."
	]
	quest.14436C9E32F126F9.title: "Дыхание"
	quest.1451E84B67CB8451.quest_desc: [
		"Владыка — тот, кто удержал один голос слишком долго и переглох. Такие не умирают: они глохнут и становятся тем, что мы зовём боссом."
		"Потому их не проходят: к ним приходят с выносливостью, умением и планом."
	]
	quest.1451E84B67CB8451.title: "Владыка — это не чудовище"
	quest.1453C550248F2A02.quest_desc: ["Улучшения меняют профессию крысы: повар, рудокоп, лекарь, воин. Ставь их в крысиный инвентарь."]
	quest.1453C550248F2A02.title: "Крысиные улучшения"
	quest.1460053105130E6D.quest_desc: [
		"Еда лечит фамильяра ровно настолько, насколько насытила бы тебя — но сначала её надо провести через уменьшающую станцию."
		"Мясо, похлёбки, хлеб: держи запас в рюкзаке, а не в сундуке дома."
	]
	quest.1460053105130E6D.title: "Кормление"
	quest.14A5AE0FD2B9C32C.quest_desc: [
		"Familiar Guide объясняет механику, а Familiar Compendium — где живёт каждый фамильяр и чем он воюет."
		"Не читай гайды в интернете: у мода свой справочник, и он точнее."
	]
	quest.14A5AE0FD2B9C32C.title: "Справочник"
	quest.14E73946A569C806.quest_desc: [
		"1. Правый клик по статуе — положить ингредиент, повторный — забрать."
		"2. Правый клик по Ритуальному Ядру — центральный предмет."
		"3. Совпало с рецептом — ядро заряжается 5 секунд, результат появляется на нём. Убрал предмет — ритуал сбрасывается."
	]
	quest.14E73946A569C806.title: "Как идёт ритуал"
	quest.14F6BCE0D39BE42B.quest_desc: [
		"Станция скульптур превращает фото фамильяра в статую: друид вырезает из дерева, иллюзионист раскрашивает."
		"Пюпитр смотрит на тебя, скульптура появляется позади. Размер — от полблока до трёх, фото не тратится."
	]
	quest.14F6BCE0D39BE42B.title: "Скульптуры"
	quest.157880DE6714441F.quest_desc: [
		"Лут здесь падает щедро, и без рюкзака ты вернёшься за ним трижды — а мир не любит, когда его грабят дважды."
		"Рюкзак из Sophisticated Backpacks ставь на землю и открывай: внутри карманы, фильтры, автосбор с земли."
	]
	quest.157880DE6714441F.title: "Рюкзак"
	quest.15855803888B3BFA.quest_desc: [
		"Если фамильяр вот-вот умрёт: при ачивке «Learn Necromancy» (Мёртвый Король) и 80 маны он вернётся на половине здоровья."
		"Иначе тратится привязанный к нему Крошечный Тотем. Без тotemа — только ждать и растить заново."
	]
	quest.15855803888B3BFA.title: "Возрождение"
	quest.15E7F0E9EFF1368C.quest_desc: [
		"Из-за Cinematic Interactions верстак, печь, коптильня, домна, стол зачарований, наковальня, точило, кузнечный стол, камнерез, ткацкий станок, картографический стол, варочная стойка, крафтер, костёр, кафедра, маяк и музыкальный блок открываются не окном, а сценой от первого лица."
		"Ты подходишь, кладёшь предметы руками и собираешь рецепт прямо на столе. Камера подстраивается, если подойти с другой стороны."
		"Клавиша G — правка сетки под свой ресурспак: сдвиг, поворот, размер ячеек. Esc или быстрый выход — и ты снова в бою."
	]
	quest.15E7F0E9EFF1368C.title: "Станции — это сцена"
	quest.15E856070499C6FF.quest_desc: [
		"Тишина, приходящая раньше бури. Он не бьёт первым — он просто приходит, и после него не остаётся звука."
		"На его фоне любой нестрой кажется мелодией."
	]
	quest.15E856070499C6FF.quest_subtitle: "Предание V"
	quest.15E856070499C6FF.title: "Предвестник"
	quest.1635EBEEC6992BA8.quest_desc: [
		"Врата Вечности открываются не ключом, а подготовкой. Внутри — волны тварей и один Владыка."
		"Каждые врата — выбор: прийти неподготовленным и стать частью нестроя, или унести голос с собой."
	]
	quest.1635EBEEC6992BA8.title: "Врата"
	quest.1647818143534ECA.quest_desc: [
		"Глаз падает один раз. Совсем. Второй раз босс его не отдаст — и ачивка помнит, что ты его уже получал."
		"Последний удар должен быть твой: если добивает фамильяр, око не выпадет."
	]
	quest.1647818143534ECA.title: "Один раз на игрока"
	quest.1666D6EEC33D52D0.quest_desc: [
		"За трофеи Владык платят легендарным чернилом: одно за простого, два за тяжёлого."
		"Чернило — это не деньги, это сила книги заклинаний. Копи и вкладывай в то, чем реально пользуешься."
	]
	quest.1666D6EEC33D52D0.title: "Награда за голову"
	quest.1683587A60654CF0.quest_desc: [
		"Трофей с Йети. Пока око у тебя, ачивка помнит: второй раз оно не выпадет."
		"Потеряешь — восстановишь ритуалом на Острове Истоков, ценой трофея и материалов."
	]
	quest.1683587A60654CF0.quest_subtitle: "1 легендарное чернило"
	quest.1683587A60654CF0.title: "Ледяное Око"
	quest.16A9D13B795DE301.quest_desc: [
		"Забытый остров в океане — место, где фамильяры вообще появились. Искать фрагментами памяти: они летят как глаз Эндера."
		"В центре — единственная в мире ритуальная площадка."
	]
	quest.16A9D13B795DE301.title: "Остров Истоков"
	quest.16C2A4D9D7D49118.quest_desc: [
		"Фамильяр качается боем и едой. Уровни дают ему свои заклинания и живучесть."
		"Мёртвый фамильяр — не потерянный: он возвращается, но теряет часть накопленного."
	]
	quest.16C2A4D9D7D49118.title: "Уровни фамильяра"
	quest.16ECD967C214B2AB.quest_desc: [
		"Драконы держат собственный строй: огненные, ледяные, грозовые. Каждый уверен, что мир должен звучать как он."
		"Ищи гнездовья в горах и пустошах — там же их самки и яйца."
	]
	quest.16ECD967C214B2AB.title: "Гнездовья"
	quest.1749DBBBB5553E17.quest_desc: [
		"Заклинание не произносят по команде: его слышат и в него попадают. Мана — только плата за внимание."
		"Свитки больше не падают с мобов: заклинание нужно найти, выучить и запомнить."
	]
	quest.1749DBBBB5553E17.title: "Не сила, а слух"
	quest.17CA78D9ED09502E.quest_desc: [
		"Фамильяр — не питомец. Это тот, кто слышит за тебя и подпевает в полутоне."
		"Носить можно до десяти фамильяров, ещё десять живут в Доме фамильяра и в лимит не входят."
		"H — выбрать, X — призвать или отправить обратно, Shift+X — призвать всех разом."
	]
	quest.17CA78D9ED09502E.title: "Второй голос"
	quest.185A6727C2EB0130.quest_desc: [
		"Пустой сосуд снимает цвета с фамильяра и возвращает ему родной вид. Заряженный — переносит цвета на другого фамильяра того же типа."
		"Части с родным видом берут цвет, уже окрашенные — смешиваются. Только так получаются смешанные окрасы."
		"Пустой сосуд в центре ритуала копирует заряженный, не расходуя оригинал."
	]
	quest.185A6727C2EB0130.title: "Сосуд личности"
	quest.189CAC817583C7B1.quest_desc: [
		"Станция архимага: берёт свитки из контейнеров в 3 блоках, перебрасывает и возвращает."
		"Каждые 2 секунды свиток становится случайным той же редкости, с шансом 5% на ранг выше. Редкость никогда не падает."
		"Заклинания этого мода (Megido, Ice Age, Fire Fist) добываются только здесь."
	]
	quest.189CAC817583C7B1.title: "Переброс свитков"
	quest.191010C8E5F1B4CC.quest_desc: [
		"Правый клик палкой — фамильяр садится и не лезет в драку. Повторный клик поднимает, урон тоже."
		"Предмет-команду можно менять тегами, если палка занята под другое."
	]
	quest.191010C8E5F1B4CC.title: "Сидеть"
	quest.1913CC1FB851FA3F.quest_desc: [
		"Раненый фамильяр сам ищет свободную кровать рядом и спит в ней, пока не восстановится."
		"В кровати ещё и вылупляются яйца фамильяров: пока там яйцо, спать некому."
	]
	quest.1913CC1FB851FA3F.title: "Кровать фамильяра"
	quest.192C1C068CF9BD51.quest_desc: [
		"Трофей с Незеритовое Чудовище. Пока око у тебя, ачивка помнит: второй раз оно не выпадет."
		"Потеряешь — восстановишь ритуалом на Острове Истоков, ценой трофея и материалов."
	]
	quest.192C1C068CF9BD51.quest_subtitle: "2 легендарных чернила"
	quest.192C1C068CF9BD51.title: "Проклятое Око"
	quest.196BA32898D8F472.quest_desc: [
		"Правый клик по приручённому фамильяру расходником — постоянный плюс к стату."
		"Три ступени: броня (железная, алмазная, незеритовая), жизнь (плоды), сила магии и сопротивление, уровень магии."
		"Каждая ступень перестаёт работать на своём пределе — дальше нужна следующая."
	]
	quest.196BA32898D8F472.title: "Улучшения"
	quest.19BEE6B812DA7969.quest_desc: [
		"Insignia of the Lich (некромант), Contaminated Cheese (чумной доктор), Dragon Tear (драгуун)."
		"Три самые злые дороги: некромант поднимает, чумной травит, драгуун бьёт с воздуха."
	]
	quest.19BEE6B812DA7969.title: "Тёмные тринкеты"
	quest.19E4B0FB17DBA37D.quest_desc: [
		"Его собрали из металла, который помнит прикосновение. Оно глухо ко всему, кроме собственного веса."
		"Пустоши куют такое оружие, но не умеют его останавливать."
	]
	quest.19E4B0FB17DBA37D.quest_subtitle: "Предание III"
	quest.19E4B0FB17DBA37D.title: "Незеритовое Чудовище"
	quest.19F34324BCE1BA65.quest_desc: [
		"Том фамильяра — его память: там уровни, характеристики и что он умеет сейчас."
		"Открывается правой кнопкой, работает как второй инвентарь для самого фамильяра."
	]
	quest.19F34324BCE1BA65.title: "Книга фамильяра"
	quest.1A0679BF09BC97B1.quest_desc: [
		"Он был здесь до голосов. Песок помнит его шаги лучше, чем люди — его имя."
		"Оставь ему воду, если найдёшь. Иногда этого хватает."
	]
	quest.1A0679BF09BC97B1.quest_subtitle: "Предание VIII"
	quest.1A0679BF09BC97B1.title: "Древний Остаток"
	quest.1A4F82E271F08B68.quest_desc: [
		"Тринкет — слот Curios, который работает только на «своего» фамильяра: он даёт бонусы ему и тебе, пока фамильяр призван."
		"Тринадцать штук под тринадцать дорог: Shiny Crown, Lost Melody, Blessed Calyx, Magic Leaf, Frostbloom, Chain of the Hunter, Golden Bell, Emblem of Electricity, Insignia of the Lich, Contaminated Cheese, Conjurer's Candlestick, Forgotten Crown, Dragon Tear."
		"Смотри Compendium: у каждого тринкета своя школа и свой бонус."
	]
	quest.1A4F82E271F08B68.title: "Тринкеты"
	quest.1A70591A605916E4.quest_desc: ["Сковорода — быстрый ужин в поле. Мясо, овощи, немного соли — и ты снова человек."]
	quest.1A70591A605916E4.title: "Сковорода"
	quest.1ABDACC728F91066.quest_desc: ["Крысы не боевая сила мира — они про уют и мелкую автоматизацию. И про то, чтобы не таскать всё самому."]
	quest.1ABDACC728F91066.title: "Крысиный король"
	quest.1AC0321083C8FB41.quest_desc: [
		"Ставится не дальше 10 блоков от ядра (5 по высоте), сундук или бочка — строго под ним."
		"Открыть, выбрать рецепт, «Set Recipe», назначить архимага — и он таскает предметы через портал сам."
		"Несколько автоматов на одно ядро работают по очереди и помогают друг другу ингредиентами."
	]
	quest.1AC0321083C8FB41.title: "Ритуальный автомат"
	quest.1AC2512266D20CDF.quest_desc: [
		"Игнис назвал пожар своим именем и уже не смог отказаться. Он не сгорает — он горит, потому что иначе перестанет быть собой."
		"В недрах, где Огонь звучит без остановки, всё живое либо жжётся, либо выковано."
	]
	quest.1AC2512266D20CDF.quest_subtitle: "Предание II"
	quest.1AC2512266D20CDF.title: "Владыка Огня"
	quest.1ADF670EE3354E43.quest_desc: [
		"Прокачка здесь — не уровни, а слух. Опыт превращается в очки дерева Puffish, а дерево — в то, какие голоса ты слышишь."
		"Открой дерево клавишей скиллов и не разбрасывай очки: каждый узел — это твой характер, а не строчка в статах."
	]
	quest.1ADF670EE3354E43.title: "Слух"
	quest.1AF63CEE058DFF84.quest_desc: ["Rats — для тех, кто любит крысок. Приручи, посади в клетку, научи собирать лут и варить сыр."]
	quest.1AF63CEE058DFF84.title: "Крысы"
	quest.1B1BA9B0065AA844.quest_desc: [
		"Он был первым, кто удержал голос Крови дольше, чем следовало. Корона осталась, королевство — нет: остались кости и книга."
		"Его фолиант ищет нового читателя. Не читай вслух."
		"Лор открывается сам — по ачивке Iron's Spellbooks. Награда: два легендарных чернила."
	]
	quest.1B1BA9B0065AA844.quest_subtitle: "Предание I"
	quest.1B1BA9B0065AA844.title: "Мёртвый Король"
	quest.1B5002930911AED0.quest_desc: [
		"Трофей с Сциллу. Пока око у тебя, ачивка помнит: второй раз оно не выпадет."
		"Потеряешь — восстановишь ритуалом на Острове Истоков, ценой трофея и материалов."
	]
	quest.1B5002930911AED0.quest_subtitle: "2 легендарных чернила"
	quest.1B5002930911AED0.title: "Повреждённое Око"
	quest.1B58FF06AFC75B4B.quest_desc: [
		"Трофей с Вызывателя. Пока око у тебя, ачивка помнит: второй раз оно не выпадет."
		"Потеряешь — восстановишь ритуалом на Острове Истоков, ценой трофея и материалов."
	]
	quest.1B58FF06AFC75B4B.quest_subtitle: "1 легендарное чернило"
	quest.1B58FF06AFC75B4B.title: "Магическое Око"
	quest.1B5AAE715CC14F67.quest_desc: [
		"Сет Familiologist — твой, не фамильяров: шлем, нагрудник, штаны, ботинки."
		"Чистый фамильярный сет без магии бесполезен — качай ветку фамильяров в дереве навыков."
	]
	quest.1B5AAE715CC14F67.title: "Броня фамилиолога"
	quest.1B6380A1BAA19FAA.quest_desc: [
		"Заклинания не только учат, но и куют: наковальня и стол надписей меняют свитки, а кузня свитков собирает новые."
		"Чернило определяет редкость. Легендарное — предел, и его добывают с Владык."
	]
	quest.1B6380A1BAA19FAA.title: "Кузня заклинаний"
	quest.1B9235B28654B29A.quest_desc: [
		"Трофей с Предвестника. Пока око у тебя, ачивка помнит: второй раз оно не выпадет."
		"Потеряешь — восстановишь ритуалом на Острове Истоков, ценой трофея и материалов."
	]
	quest.1B9235B28654B29A.quest_subtitle: "2 легендарных чернила"
	quest.1B9235B28654B29A.title: "Зловещее Око"
	quest.1BA757515BC1FF90.quest_desc: [
		"Улучшать книгу — чернилами: от обычных до легендарных. Легендарное чернило — главная валюта силы здесь."
		"Боссы дают его за трофеи: одно за простого, два за тяжёлого."
	]
	quest.1BA757515BC1FF90.title: "Чернила"
	quest.1BF3267B4E45F4BD.quest_desc: [
		"Стол зачарований, наковальня и точило — тоже сцены Cinematic Interactions: книгу и предметы видно на столе, а не в слотах."
		"Рецепты при этом не ванильные: часть изменена, часть убрана совсем. Не спорь с памятью, спорь с JEI — R показывает крафт, U применение. Нет в JEI — значит нет вообще."
	]
	quest.1BF3267B4E45F4BD.title: "Зачарование и ремонт"
	quest.1C15F61A081AC136.quest_desc: [
		"Аддоны не декорация: Cataclysm Spellbooks приносит заклинания под боссов Катаклизма, Monsters Spellbooks — магию чудовищ."
		"У них свои школы, свои чернила и свои книги — читай JEI, а не описания в интернете."
	]
	quest.1C15F61A081AC136.title: "Катаклизм и монстры"
	quest.1C203BD798208C2C.quest_desc: [
		"Тёмный Допельгангер — тот, кто смотрит на тебя твоими глазами. С него падает Старинное Око."
		"Не бей его в одиночку и не бей в спину зеркалу."
	]
	quest.1C203BD798208C2C.title: "Допельгангер"
	quest.1C4F2643DDB093A7.quest_desc: [
		"Ванильные глаза Эндера портал не откроют: нужны глаза End Remastered, у каждого своё имя и свой владелец."
		"Двенадцать в рамки — и Край откроется. Каждый глаз — трофей, а не находка в сундуке: из структур мы их вырезали."
	]
	quest.1C4F2643DDB093A7.title: "Двенадцать глаз"
	quest.1C774DF1D9A6650C.quest_desc: [
		"Место, где ты умер, помнится плохо. Ставь метку до похода, а не после."
		"Кровать в новом доме — тоже метка, только дороже."
	]
	quest.1C774DF1D9A6650C.title: "Метка на карте"
	quest.1CA2954473C8BE0F.quest_desc: [
		"Портал Края — двенадцать рамок по кругу. Каждая требует глаза, и глаз в ней остаётся навсегда."
		"Значит, двенадцать глаз — не запас, а ровно необходимое."
	]
	quest.1CA2954473C8BE0F.title: "Рамки портала"
	quest.1CAC5C81D444E698.quest_desc: [
		"Трофей с Тёмного Допельгангера. Пока око у тебя, ачивка помнит: второй раз оно не выпадет."
		"Потеряешь — восстановишь ритуалом на Острове Истоков, ценой трофея и материалов."
	]
	quest.1CAC5C81D444E698.quest_subtitle: "2 легендарных чернила"
	quest.1CAC5C81D444E698.title: "Старинное Око"
	quest.1CBAC82E970B0CDA.quest_desc: [
		"Трофей с Пиратского капитана. Пока око у тебя, ачивка помнит: второй раз оно не выпадет."
		"Потеряешь — восстановишь ритуалом на Острове Истоков, ценой трофея и материалов."
	]
	quest.1CBAC82E970B0CDA.quest_subtitle: "1 легендарное чернило"
	quest.1CBAC82E970B0CDA.title: "Чёрное Око"
	quest.1CC0FAA6A83F15D6.quest_desc: [
		"Трофей с Стража Края. Пока око у тебя, ачивка помнит: второй раз оно не выпадет."
		"Потеряешь — восстановишь ритуалом на Острове Истоков, ценой трофея и материалов."
	]
	quest.1CC0FAA6A83F15D6.quest_subtitle: "2 легендарных чернила"
	quest.1CC0FAA6A83F15D6.title: "Загадочное Око"
	quest.1D339750BC579E67.quest_desc: [
		"Discerning the Eldritch даёт голос Грани: он звучит с другой стороны и потому слышен как эхо."
		"Звёздный металл, элдрические осколки и запретные улучшения слотов — всё оттуда. Сильно и дорого."
	]
	quest.1D339750BC579E67.title: "Элдрическая магия"
	quest.1D44125E0A7D8862.quest_desc: [
		"Трофей с Древнего Остатка. Пока око у тебя, ачивка помнит: второй раз оно не выпадет."
		"Потеряешь — восстановишь ритуалом на Острове Истоков, ценой трофея и материалов."
	]
	quest.1D44125E0A7D8862.quest_subtitle: "2 легендарных чернила"
	quest.1D44125E0A7D8862.title: "Потерянное Око"
	quest.1D545029C3BA4E0B.quest_desc: [
		"Каждый осколок — призыв готового фамильяра: Archmage, Druid, Frostling, Hunter, Illusionist, Lightning Mage, Bard, Cleric, Plague Doctor, Necromancer, Scorcher, Dragoon, Summoner."
		"Все они делаются ритуалами на острове. У фамильяров с цветом от биома цвет берётся из места, где использован осколок."
	]
	quest.1D545029C3BA4E0B.title: "Осколки фамильяров"
	quest.1D5C5BC2F9FB98D6.quest_desc: [
		"Дикий фамильяр приручается правым кликом с эссенцией тайной магии: одна попытка — одна эссенция, шанс 40%."
		"Сердечки — получилось, дымок — пробуй снова. Только что приручённый сразу призван, так что нужен свободный слот."
	]
	quest.1D5C5BC2F9FB98D6.title: "Приручение"
	quest.1D70EA5612F3047E.quest_desc: [
		"Blessed Calyx (клирик), Lost Melody (бард), Magic Leaf (лесной), Golden Bell (иллюзионист)."
		"Поддержка в этом паке не декорация: бард и клирик реально тянут бой, когда ты не танк."
	]
	quest.1D70EA5612F3047E.title: "Тринкеты поддержки"
	quest.1D9B83044EE6AFC8.quest_desc: [
		"Часть блоков работает на фамильярах: назначаешь одного — и он уходит с твоей панели работать на блоке, пока не снимешь."
		"Кто первый назначил, тот и хозяин блока. Сломал блок — фамильяры освободились."
	]
	quest.1D9B83044EE6AFC8.title: "Рабочие фамильяры"
	quest.1DA41566205DAFDD.quest_desc: [
		"Block Factory's Bosses приносит своих: йети, песчаный червь, кракен, пиратский капитан и их экипажи."
		"Трофеи этих боссов нужны для ритуалов глаз — не выбрасывай."
	]
	quest.1DA41566205DAFDD.title: "Кузнецы и пираты"
	quest.1DAA260D8D2A02E5.quest_desc: [
		"Сытость одной и той же едой со временем не восстанавливается как раньше. Одно блюдо — одна нота, а тело требует строя."
		"Держи в рационе мясо, овощи, похлёбки и что-нибудь сладкое. Готовь в котле Farmer's Delight — это дешевле, чем лечиться."
	]
	quest.1DAA260D8D2A02E5.title: "Разная еда"
	quest.1DB312B87EEBEE80.quest_desc: [
		"Трофей с Игниса. Пока око у тебя, ачивка помнит: второй раз оно не выпадет."
		"Потеряешь — восстановишь ритуалом на Острове Истоков, ценой трофея и материалов."
	]
	quest.1DB312B87EEBEE80.quest_subtitle: "2 легендарных чернила"
	quest.1DB312B87EEBEE80.title: "Око Ада"
	quest.1DC0107BEEEA694B.quest_desc: [
		"Отдельная ветка школ: огонь, лёд, молния, кровь, эндер, природа, святость, элдрич."
		"Качая школу, ты усиливаешь не «магию вообще», а конкретный голос — и это чувствуется на боссах."
	]
	quest.1DC0107BEEEA694B.title: "Школы"
	quest.1DED62B152D69607.quest_desc: [
		"Потерять око в Крае можно, и это не приговор: на Острове Истоков есть ритуал восстановления."
		"Центр — глаз Эндера, на четырёх статуях — трофей того самого босса, звезда Нижнего мира, игнитиевый слиток и драконья сталь любого вида."
		"Дорого. Дороже, чем убить босса. Так и задумано."
	]
	quest.1DED62B152D69607.title: "Страховка"
	quest.1E30E5705005CD7C.quest_desc: [
		"Наш фамильяр — Соглядатай: тот, кто смотрит за тебя. В лоре он с Края, где открываются глаза, и не все они человеческие."
		"Бьёт из посоха льдом, спектральными разрядами и кровавыми росчерками, телепортируется, держит дистанцию и зовёт подмогу."
		"С Оком Соглядатая призывает ещё и Рыцаря Смерти."
	]
	quest.1E30E5705005CD7C.title: "Соглядатай"
	quest.1E9D4AAE86DB41C6.quest_desc: [
		"С Pandora's Box в слоте тринкета можно выбрать несколько фамильяров и призывать их одним нажатием."
		"Для армии из десяти — единственный способ не сходить с ума по клавишам."
	]
	quest.1E9D4AAE86DB41C6.title: "Ящик Пандоры"
	quest.1EB1A4AA4D031AB4.quest_desc: [
		"Редкость с Острова Истоков: семь урона, бонус урона фамильяра, кулдаунов и силы чар."
		"Чаще всего его выкапывают из подозрительного песка на острове."
	]
	quest.1EB1A4AA4D031AB4.title: "Идол фамильяра"
	quest.1EEEA535832875F0.quest_desc: [
		"Готовка — не побочка. Котёл Farmer's Delight варит похлёбки, которые держат дольше и лечат лучше."
		"Одно и то же блюдо приедается: сытость от повторов падает."
	]
	quest.1EEEA535832875F0.title: "Котёл"
	quest.1EF52B73E8D49CD3.quest_desc: [
		"В дереве навыков у фамильяров своя ветка — урон, живучесть, кулдауны. Это фича сборки, а не украшение."
		"Качай, если воюешь чужими руками. Качай, если своих уже не хватает."
	]
	quest.1EF52B73E8D49CD3.title: "Ветка фамильяров"
	quest.1F504D895822EC9B.quest_desc: [
		"У фамильяров своя ветка в дереве навыков — это фича сборки, а не украшение: урон, живучесть, кулдауны."
		"Качай её, если воюешь чужими руками. Качай, если своих уже не хватает."
	]
	quest.1F504D895822EC9B.title: "Фамильяры в дереве"
	quest.1FBA4786CD59110E.quest_desc: [
		"Трофей с Кракена. Пока око у тебя, ачивка помнит: второй раз оно не выпадет."
		"Потеряешь — восстановишь ритуалом на Острове Истоков, ценой трофея и материалов."
	]
	quest.1FBA4786CD59110E.quest_subtitle: "2 легендарных чернила"
	quest.1FBA4786CD59110E.title: "Экзотическое Око"
	quest.1FC54B87B6387C03.quest_desc: [
		"Тринкет с острова: +15% силы чар и +15% элдрической защиты, плюс разрешение Соглядатаю на Рыцаря Смерти."
		"Не верстак, а ритуал на Острове Истоков: глаз Эндера в центр, вокруг — эхо, элдрический осколок души, призматический осколок и пойманная душа."
	]
	quest.1FC54B87B6387C03.title: "Око Соглядатая"
}
